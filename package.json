{
  "name": "incident",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently -n server,expo -c blue,green \"npm:server\" \"npm:expo-start\"",
    "expo-start": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start",
    "server": "node --watch-path=backend/server.js --watch-path=backend/config --watch-path=backend/.env backend/server.js",
    "reset-project": "node ./scripts/reset-project.js",
    "setup-firestore": "node ./scripts/setupFirestore.js",
    "create-users": "node ./scripts/createUsers.js",
    "set-user-role": "node ./scripts/setUserRole.js",
    "delete-user": "node ./scripts/deleteUser.js",
    "test:rules": "npx firebase-tools emulators:exec --only firestore --project rules-test-agency-isolation \"node ./scripts/testRules.js\"",
    "deploy:rules": "node ./scripts/deployRules.js",
    "android": "concurrently -n server,expo -c blue,green \"npm:server\" \"cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --android\"",
    "ios": "concurrently -n server,expo -c blue,green \"npm:server\" \"cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --ios\"",
    "web": "concurrently -n server,expo -c blue,green \"npm:server\" \"cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --web\"",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@firebase/auth": "^1.13.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.4.2",
    "expo": "^58.0.0",
    "expo-auth-session": "~58.0.19",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-print": "~58.0.7",
    "expo-router": "~58.0.26",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^11.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "mysql2": "^3.16.0",
    "nodemailer": "^9.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "~19.3.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
