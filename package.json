{
  "name": "incident",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently -n server,expo -c blue,green \"npm:server\" \"npm:expo-start\"",
    "expo-start": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start",
    "server": "node backend/server.js",
    "reset-project": "node ./scripts/reset-project.js",
    "setup-firestore": "node ./scripts/setupFirestore.js",
    "create-users": "node ./scripts/createUsers.js",
    "set-user-role": "node ./scripts/setUserRole.js",
    "delete-user": "node ./scripts/deleteUser.js",
    "test:rules": "npx firebase-tools emulators:exec --only firestore --project rules-test-agency-isolation \"node ./scripts/testRules.js\"",
    "deploy:rules": "node ./scripts/deployRules.js",
    "android": "concurrently -n server,expo -c blue,green \"npm:server\" \"cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --android\"",
    "ios": "concurrently -n server,expo -c blue,green \"npm:server\" \"cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --ios\"",
    "web": "concurrently -n server,expo -c blue,green \"npm:server\" \"cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --web\"",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@firebase/auth": "^1.13.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.4.2",
    "expo": "^57.0.0",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.17",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.17",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^11.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "mysql2": "^3.16.0",
    "nodemailer": "^9.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "~19.2.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
